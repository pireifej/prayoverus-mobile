{
  "expo": {
    "name": "PrayOverUs",
    "slug": "pray-over-us",
    "version": "1.0.30",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "prayoverus",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#6366f1"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "buildNumber": "69",
      "bundleIdentifier": "com.pireifej.prayoverus",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:prayoverus.com",
        "applinks:www.prayoverus.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.798628803696-2sodci2f99h4ojbhiqm851im6bgjuiqg"
            ]
          }
        ]
      }
    },
    "notification": {
      "icon": "./assets/cross-hands.png",
      "color": "#2563eb"
    },
    "android": {
      "versionCode": 86,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#6366f1"
      },
      "package": "com.pireifej.prayoverus",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "NOTIFICATIONS",
        "com.google.android.gms.permission.AD_ID"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "prayoverus.com"
            },
            {
              "scheme": "https",
              "host": "www.prayoverus.com"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "com.googleusercontent.apps.798628803696-u3oc9tra2qou9j581u716nr9fst1m8mt"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "./withAdsKotlinFix",
      "react-native-edge-to-edge",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "enableProguardInReleaseBuilds": false,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "kotlinVersion": "1.9.24"
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3440306279423513~2757859969",
          "iosAppId": "ca-app-pub-3440306279423513~1181052436"
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "91bdb01b-1012-49e1-abb4-fc8fae904ec8"
      }
    },
    "owner": "pireifej",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/91bdb01b-1012-49e1-abb4-fc8fae904ec8"
    }
  }
}
